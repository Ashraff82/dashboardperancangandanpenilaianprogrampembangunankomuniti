# Database URL — Supabase PostgreSQL (direct connection)
# Copy this file to `.env` and replace with your real credentials.
#
# IMPORTANT: If your password contains special characters like @, #, /, etc.,
# they MUST be URL-encoded. For example, the password "Ashraff@supabase315"
# becomes "Ashraff%40supabase315" in the connection string below.
#
# Format:
#   postgresql://postgres:<URL_ENCODED_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres
#
# Example:
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Alternative: Supabase connection pooler (IPv4, use if direct connection has IPv6 issues)
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
